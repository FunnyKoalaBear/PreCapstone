# Copy to Factory_Server/.env and fill in the blanks. Never commit .env.

# Postgres on the factory server (port 6900, local only)
DB_HOST=localhost
DB_PORT=6900
DB_NAME=factory_tracker
DB_USER=factory_app
DB_PASSWORD=

# CUPS queue for print_service/print_pdf.py (direct IPP queue, see SERVER_SETUP.md)
PRINTER_NAME=Brother_HL_L2460DW_direct

# AWS S3 for AWS_S3/s3.py and s3_pdf.py
S3_BUCKET=
AWS_REGION=ap-northeast-1
# boto3 reads these itself (or use ~/.aws/credentials instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
