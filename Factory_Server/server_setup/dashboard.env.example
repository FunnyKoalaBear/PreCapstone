# Django settings for the factory server. Copy to Web_Application/.env and fill in the blanks. Never commit .env.
# (Web_Application/.env.example is the generic one for a development laptop.)

# Generate one: Web_Application/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# Hostnames Django answers to; "*" accepts any (development only)
ALLOWED_HOSTS=192.168.8.155,factory-server.lan,factory-server.local,factory-server.tail8b0d7e.ts.net,localhost,127.0.0.1
# Only needed if a login form is reached through a new HTTPS name
CSRF_TRUSTED_ORIGINS=

# Postgres on the factory server (port 6900, local only)
DB_NAME=dashboard
DB_USER=factory_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=6900

# Hours a box may sit idle before it is flagged stagnant
STAGNATION_DEFAULT_HOURS=24
# Hours a login lasts
SESSION_HOURS=12
# Seconds in which a repeat scan of the same tag is ignored (0 = off)
SCAN_REPEAT_SECONDS=5
# Password of the demo_* users (seed_demo)
DEMO_PASSWORD=
